# Copy to .env and fill locally. NEVER commit .env.
APP_ENV=
APP_BASE_URL=
INTERNAL_API_TOKEN=
PII_SALT=

# LLM. Production target is meta (Muse). groq is a temporary dev fallback only.
# Exact model ids are TODO verify. Do not treat a filled example as a pinned id.
LLM_PROVIDER=groq            # groq | meta
GROQ_API_KEY=
GROQ_TEXT_MODEL=             # dev fallback only. TODO verify
GROQ_VISION_MODEL=           # dev fallback only. TODO verify
GROQ_TRANSCRIBE_MODEL=       # unused; speech is Intron. TODO verify if a fallback is ever required
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=             # Muse Spark series (text/agent). TODO verify exact id
META_VISION_MODEL=           # Muse vision (images). TODO verify exact id
# Muse Image and SAM 3.1 ids are also TODO verify when those calls are added.

# Speech (Intron Sahara v2.5). No value in this file.
INTRON_API_KEY=

# Jev / TypeSafe
TYPESAFE_API_KEY=

# Meta platforms
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
