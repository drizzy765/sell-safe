# Copy to .env and fill locally. NEVER commit .env.
# Onboarding site proxy (web/). Defaults to this URL when unset.
API_BASE_URL=http://127.0.0.1:8000
APP_ENV=
APP_BASE_URL=
INTERNAL_API_TOKEN=
PII_SALT=

# LLM. Production target is meta (Muse). groq is a temporary dev fallback only.
# Exact model ids are TODO verify. Do not treat a filled example as a pinned id.
LLM_PROVIDER=groq            # groq | meta
GROQ_API_KEY=
GROQ_TEXT_MODEL=             # dev fallback only. TODO verify
GROQ_VISION_MODEL=           # dev fallback only. TODO verify
GROQ_TRANSCRIBE_MODEL=       # unused; speech is Intron. TODO verify if a fallback is ever required
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=             # Muse Spark series (text/agent). TODO verify exact id
META_VISION_MODEL=           # Muse vision (images). TODO verify exact id
# Muse Image and SAM 3.1 ids are also TODO verify when those calls are added.

# Speech (Intron Sahara v2.5). No value in this file.
INTRON_API_KEY=
INTRON_STT_URL=             # TODO verify exact STT endpoint

# Jev / TypeSafe
TYPESAFE_API_KEY=
TYPESAFE_API_BASE_URL=https://api.typesafe.ai

# Meta platforms
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
# Instagram product credentials (Instagram → API setup with Instagram login).
# INSTAGRAM_APP_ID is NOT META_APP_ID — wrong id → Meta "Invalid platform app".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Instagram Login OAuth (seller Connect on the website). redirect_uri must match
# Meta App → Instagram → API setup with Instagram login → Business login settings
# → Valid OAuth Redirect URIs EXACTLY (https required; http://localhost is often rejected).
# Prefer your public HTTPS API tunnel + FastAPI callback:
INSTAGRAM_OAUTH_REDIRECT_URI=https://<your-tunnel>/api/instagram/oauth/callback
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
# Frontend origin. FastAPI callback hands the session cookie to this host.
WEB_BASE_URL=http://localhost:3000
# Official Sell-Safe Instagram (sellsafe.ng). Comma-separated Graph/Messaging ids.
# DMs here get a connect/marketing reply only — catalog runs on connected seller shops.
SELLSAFE_OFFICIAL_IG_ACCOUNT_IDS=
# Public site linked from that official-page reply.
SELLSAFE_SITE_URL=https://sellsafe.ng
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=

# Payments (test mode only)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
MONO_SECRET_KEY=
ALERT_INBOUND_SECRET=

# USDC on Base. Testnet by default. Mainnet is a switch: set network, chain id, RPC, and token.
# The seller wallet is saved in onboarding, not here. Amounts are USDC base units (6 decimals).
CRYPTO_NETWORK=base-sepolia
CRYPTO_RPC_URL=
CRYPTO_CHAIN_ID=84532
CRYPTO_TOKEN_CONTRACT=          # Base Sepolia USDC, e.g. 0x036CbD53842c5426634e7929541eC2318f3dCF7e
CRYPTO_MIN_CONFIRMATIONS=3
CRYPTO_EXPLORER_URL=https://sepolia.basescan.org
# Live payment-safety demo. Paste a real Base Sepolia USDC transfer to the demo seller wallet.
DEMO_REAL_TX_HASH=

# Google Drive catalog import (public "Anyone with the link" folders).
# Create a key in Google Cloud → APIs & Services → Credentials; enable Drive API.
GOOGLE_DRIVE_API_KEY=
